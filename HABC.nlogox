<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[turtles-own [
  attention
  information
  opinion
  init_caution
  caution
  v
  threshold ; used to select agents in each interation
]

globals
[
  decay_A  ; decay in attention
  actives  ; number of agents selected in each interation
  delta-variance-effect-alpha
  delta-caution
]

to setup
  
  set decay_A 1
  if topology = "Lattice" [ Lattice ]
  if topology = "Erdős-Rényi" [ Erdős-Rényi ]
  if topology = "Preferential-attachment" [ Prefential-attachment ]
  ask turtles [
    set attention random-normal mean-init-attention sd-init-attention
    set information  random-normal mean-init-information sd-init-information
    set init_caution  min-init-caution + random-float (max-init-caution - min-init-caution)
    set caution init_caution
    set opinion information
  ]
  recolor visualize
  reset-ticks
end

to go
  ask turtles [set threshold random-float 1]  ; random threshold per agent
  set actives count turtles with [attention > threshold] ; count actives
  ask turtles with [attention > threshold]  ; agent seclection depeding on attention (eq. 5)
  [
    let neigh one-of link-neighbors ; select a random neighbor
    if neigh != nobody [
      let I information   ; collect variables of agent and its neighbor
      let A_n [attention] of neigh
      let I_n [information] of neigh
      let O_n [opinion] of neigh
      if abs(opinion - O_n) < bound     ; bounded confidence
      [
        set attention min list 1 (attention + da)   ; increase attnetion due to interaction (eq. 6a)
        ask neigh [set attention min list 1 (A_n + da)] ; also in neighbor
        set information new_information I I_n attention ([attention] of neigh) ; update information (eq 7a)
        ask neigh [set information new_information I_n I attention ([attention] of myself)] ; also in neighbor
      ]
    ]
  ]
  update_decay_A  ; decay_A updated as function of difference in actives and %active_agents (intended number of actives)
  ask turtles
   [
   set attention  max list 0.00 (decay_A * attention)  ; decay in attention  (eq 6b)
   set information decay_I * (information + random-normal m-noise-information sd-noise-information) ; decay in information + noise (eq 7b)
      if model = "cusp" [set opinion opinion + cusp opinion attention information] ; update opinion (eq 4)
      if model = "MF Ising" [set opinion opinion + MF opinion attention information] ; update opinion (eq 4)
      if model = "MF Blume Capel" [set opinion opinion + MFBC opinion attention information]

  ]
  recolor visualize
    set variance-effect-alpha min list 3 variance-effect-alpha + delta-variance-effect-alpha
    set external-caution min list 1 external-caution + delta-caution
  tick
end



to-report new_information [Ii Ij Ai Aj]  ; implemention eq 6a
  let r rmin  + (1 - rmin) / (1 + exp(-1 * p * (Ai - Aj)))
  report r * Ii + (1 - r) * Ij
end

to-report cusp [O A I]  ; implementation eq. 4
  report -1 * (O ^ 3 - (A - .5) * O - I) * time-step + random-normal 0 sd-noise-opinion
end

to-report MF [O A I]  ; implementation eq. 4
  report 5 * (tanh (2 * A * (.5 * I + O)) - O) * time-step + random-normal 0 sd-noise-opinion
end

to-report MFBC [O A I]  ; implementation eq. 4
  set A 3 * A
  let neigh link-neighbors
  set v 0
  if any? neigh   [ set v variance [opinion] of (turtle-set self neigh) ]
  set caution (external-caution + init_caution) + variance-effect-alpha * v 
  ; set caution  (external-caution + init_caution)
; let caution_neigh mean [caution] of (turtle-set self neigh)
;  set caution (caution + caution_neigh) / 2
 
  let f exp (-1 * A * ((caution) ^ 2))

  let x A * (.5 * I + O)
  
  report ((2 * f * sinh x / (1 + 2 * f * cosh x)) - O) * time-step + random-normal 0 sd-noise-opinion
end

to update_decay_A  ; decay_A update function
  let d_A (1 + (%active_agents / 100) - (actives / count turtles)) * decay_A
  set d_A min list 1 d_A
  set decay_A max list .5 d_A
end

to recolor [visual]  ; color patches depending on visual (default opinion)
  if visual  = "opinion" [
    ask turtles with [opinion > 0] [set color scale-color blue opinion 2 0]
    ask turtles with [opinion <= 0] [set color scale-color red opinion -2 0]]
  if visual  = "information" [
    ask turtles with [information > 0] [set color scale-color blue information 2 0]
    ask turtles with [information <= 0] [set color scale-color red information -2 0]]
  if visual  = "attention" [
     ask turtles [set color scale-color red attention 2 0]]
  if visual  = "caution" [
     ask turtles [set color scale-color red (external-caution + caution) 2 0]]


end

to add-activists    ; add activist on mouse click
  if mouse-down? [
    ask turtles-on patch mouse-xcor mouse-ycor [
      set attention 1  ; high attention
      set information -.5 ; negative information
      set opinion -.5  ; negative opinion
      set opinion opinion + cusp opinion attention information
    ]
    display
  ]
end

to perturbate-activists  ; perturbate activists opinion in opposite direction
  let activists count turtles with [opinion < 0]
  ask n-of (activists / 2) turtles with [opinion < 0]
  [
    set opinion -1 * opinion
    set attention 1  ; set attention high
  ]
end

to-report tanh [x]
  report (exp x - exp (- x)) / (exp x + exp (- x))
end

to-report sinh [x]
  report (exp x - exp (- x)) / 2
end

to-report cosh [x]
  report (exp x + exp (- x)) / 2
end

to layout
  layout-spring turtles links 0.1 30 3 ;; put linked nodes together
end

to Erdős-Rényi
  resize-world -20 20 -20 20
  if nr-nodes > 500 [set nr-nodes 500]
   create-turtles nr-nodes [ set color blue
    set size 1
  set shape "circle"]
  ;repeat 10 [ask turtles [ create-link-with one-of other turtles ]]
  ;; lay it out so links are not overlapping

    ask turtles [
    ;; we use "self > myself" here so that each pair of turtles
    ;; is only considered once
    create-links-with turtles with [self > myself and random-float 1.0 < p-connect]
  ]
  repeat 100 [ layout]

  ;; leave space around the edges
  ask turtles [ setxy 1 * xcor 1 * ycor ]
  ;; put some "walker" turtles on the network

end

to Lattice
  resize-world -19 19 -19 19
  set nr-nodes 39 * 39
  set-patch-size 10
  let grid-size sqrt nr-nodes
  let spacing 1
  let start-x -1 * (grid-size - 1) * spacing / 2
  let start-y -1 * (grid-size - 1) * spacing / 2

  ; Create turtles in a grid
  foreach range grid-size [x ->
    foreach range grid-size [y ->
      create-turtles 1 [
        setxy (start-x + x * spacing) (start-y + y * spacing)
        set color blue
        set shape "square"
        set size 2

      ]
    ]
  ]

  ; Create links for lattice structure
  ask turtles [
    ; Link to the right neighbor
    let right-neighbor one-of turtles-on patch-at spacing 0
    if right-neighbor != nobody [ create-link-with right-neighbor ]

    ; Link to the top neighbor
    let top-neighbor one-of turtles-on patch-at 0 spacing
    if top-neighbor != nobody [ create-link-with top-neighbor ]
  ]
end

to Prefential-attachment
  if nr-nodes > 500 [set nr-nodes 500]

  set-default-shape turtles "circle"

  ;; create a random network
  create-turtles nr-nodes [
    set color blue
    set size 1
    ]
  repeat 1 [ask turtles [ create-link-with one-of other turtles ]]
  ;; lay it out so links are not overlapping
  repeat 500 [ layout-spring turtles links 0.4 4 1 ]
  ;; leave space around the edges
  ask turtles [ setxy 0.95 * xcor 0.95 * ycor ]
  ;; put some "walker" turtles on the network
end

to setup-default  ; parameter settings
 clear-all
 set %active_agents 80
 set mean-init-information 0
 set sd-init-information 0.2
 set mean-init-attention 0.5
 set sd-init-attention 0
 set da .02
 set rmin 0
 set p 3
 set decay_I 1
 set m-noise-information 0
 set sd-noise-information 0.0
 set sd-noise-opinion .001
 set time-step .01
 set bound 10
 setup
end


to setup-habc2  ; parameter settings
 clear-all
 set %active_agents 80
 set mean-init-information 0
 set sd-init-information 0.2
 set mean-init-attention 0.5
 set sd-init-attention 0
 set da .02
 set rmin 0
 set p 3
 set decay_I 1
 set m-noise-information 0
 set sd-noise-information 0.0
 set sd-noise-opinion .001
 set time-step .01
 set bound 10
 set topology  "Lattice" 
 set model "MF Blume Capel"
 set variance-effect-alpha 0
 set delta-variance-effect-alpha .001
 set external-caution 0
 set min-init-caution 0
 set max-init-caution 0
 setup
end

to setup-habc1  ; parameter settings
 clear-all
 set %active_agents 80
 set mean-init-information 0
 set sd-init-information 0.2
 set mean-init-attention 0.5
 set sd-init-attention 0
 set da .02
 set rmin 0
 set p 3
 set decay_I 1
 set m-noise-information 0
 set sd-noise-information 0.0
 set sd-noise-opinion .001
 set time-step .01
 set bound 10
 set topology  "Lattice" 
 set model "MF Blume Capel"
 set variance-effect-alpha 0
 set delta-variance-effect-alpha 0
 set delta-caution 1 / 3200
 set external-caution 0
 set min-init-caution 0
 set max-init-caution 0
 setup
end


to setup-black-pete  ; paramter settings Black Pete scanario (see HIOM paper)
 clear-all
 set %active_agents 50
 set mean-init-information .1
 set sd-init-information 0
 set mean-init-attention 0
 set sd-init-attention 0
 set da .02
 set rmin 0
 set p 4
 set decay_I 1
 set m-noise-information 0
 set sd-noise-information 0.0
 set sd-noise-opinion .001
 set time-step .01
 set bound 10
 setup
end


to setup-meat-eating-vegaterian ; paramter settings meat eating vegetarian scanario (see HIOM paper)
 clear-all
 set %active_agents 40
 set mean-init-information .1
 set sd-init-information 0
 set mean-init-attention 0
 set sd-init-attention 0
 set da .01
 set rmin 0
 set p 2
 set decay_I 1
 set m-noise-information 0
 set sd-noise-information 0
 set sd-noise-opinion .0001
 set time-step .01
 set bound .1
 setup
 ask n-of (count turtles / 5) turtles ;with [abs(pycor) < 10]
   [set information -.5
    set opinion -.5
    set attention .2
  ]
 recolor visualize
end]]></code>
