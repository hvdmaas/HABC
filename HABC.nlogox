  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="experiment" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup-habcom1</setup>
      <go>go</go>
      <exitCondition>ticks = 3200</exitCondition>
      <runMetricsCondition>ticks mod 800 = 0</runMetricsCondition>
      <metrics>
        <metric>[opinion] of turtles</metric>
        <metric>mean [attention] of turtles</metric>
        <metric>variance-effect-alpha</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="mean-init-information">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="mean-init-attention">
          <value value="0.5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="time-step">
          <value value="0.01"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="topology">
          <value value="&quot;Lattice&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="bound">
          <value value="10"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="sd-noise-opinion">
          <value value="0.001"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="decay_I">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="sd-init-information">
          <value value="0.2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="sd-init-attention">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="p">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="min-init-caution">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="p-connect">
          <value value="0.06"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="rmin">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="m-noise-information">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="visualize">
          <value value="&quot;opinion&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="variance-effect-alpha">
          <value value="2.231999999999865"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="sd-noise-information">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="model">
          <value value="&quot;MF Blume Capel&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="nr-nodes">
          <value value="9801"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="%active_agents">
          <value value="80"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="max-init-caution">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="external-caution">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="da">
          <value value="0.02"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
    <experiment name="experiment2" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup-habcom2</setup>
      <go>go</go>
      <exitCondition>ticks = 3200</exitCondition>
      <runMetricsCondition>ticks mod 800 = 0</runMetricsCondition>
      <metrics>
        <metric>[opinion] of turtles</metric>
        <metric>mean [attention] of turtles</metric>
        <metric>external-caution</metric>
